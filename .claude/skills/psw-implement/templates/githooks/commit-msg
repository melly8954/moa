#!/bin/sh
# harness-psw 커밋 메시지 검사 (5.4)
# 설정: git config core.hooksPath .githooks
#
# 첫 줄을 /bin/sh로 둔다. Git for Windows와 GitHub Desktop의 git이 모두 sh를 가지고 있다.
# 검사 스크립트는 bash로 돌린다. Windows의 PATH에서 먼저 잡히는 bash는 WSL 실행기
# (System32, WindowsApps)일 수 있다. 배포판이 없으면 실패하므로 건너뛴다.
# GitHub Desktop의 git에는 bash.exe가 없어 PATH의 WSL bash를 집는다 (2026-10 moa에서 확인)
script="$(git rev-parse --show-toplevel)/.claude/scripts/psw/check-commit-msg.sh"

for b in "$(command -v bash 2>/dev/null)" /usr/bin/bash /bin/bash \
         "/c/Program Files/Git/bin/bash.exe" "${PROGRAMFILES:-}/Git/bin/bash.exe"; do
  case "$b" in
    '' | *[Ss]ystem32* | *WindowsApps* | /Git/*) continue ;;
  esac
  [ -x "$b" ] && exec "$b" "$script" "$1"
done

# Git Bash가 없으면 지금 도는 sh를 쓴다 (Git의 sh는 bash다)
if [ -n "${BASH_VERSION:-}" ] && [ -n "${BASH:-}" ]; then
  exec "$BASH" "$script" "$1"
fi

echo "harness-psw: 커밋 검사에 쓸 bash를 찾지 못했다. Git for Windows(Git Bash)를 설치한다." >&2
exit 1
