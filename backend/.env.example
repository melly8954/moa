# 백엔드 환경변수 목록. 값은 시크릿 저장소에 두고 이 파일에는 이름만 적는다 (harness-psw 5.3)
# application.yml이 이 이름들을 읽는다. 필수 값이 비면 시작할 때 실패한다.

# DB (local 프로필은 compose.yaml이 자동으로 채운다)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT (필수. 32바이트 이상)
JWT_SECRET=
JWT_ISSUER=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# 인증 쿠키·클라이언트
AUTH_COOKIE_SECURE=true
AUTH_APP_CLIENT_ENABLED=true

# 감사 (필수. 사용자 도메인이 만든 시스템 계정의 ID)
AUDIT_SYSTEM_ACTOR_ID=

# CORS (쉼표로 구분)
CORS_ALLOWED_ORIGINS=

# API 문서 (운영에서는 false)
SWAGGER_ENABLED=false

# 프론트 주소 (인증 메일 링크, 소셜 콜백 뒤 이동)
WEB_BASE_URL=

# 메일 (MAIL_PROVIDER: smtp 또는 log)
MAIL_PROVIDER=smtp
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# 문자 (SMS_PROVIDER: solapi 또는 log. 운영은 solapi)
SMS_PROVIDER=solapi
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# 구글·카카오 로그인 (OAUTH_CALLBACK_BASE_URL은 API 주소. 제공자 콘솔에 <주소>/api/v1/auth/oauth/<google|kakao>/callback 등록)
OAUTH_CALLBACK_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 개인정보 보호 키 (휴대폰 번호 암호화, 중복 검사 HMAC). 바꾸면 기존 값을 다시 암호화해야 한다
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
