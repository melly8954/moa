# 백엔드 환경변수 목록. 값은 시크릿 저장소에 두고 이 파일에는 이름만 적는다
# application.yaml이 이 이름들을 읽는다. 필수 값이 비면 시작할 때 실패한다.

# DB (local 프로필은 compose.yaml이 자동으로 채운다)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT (필수. 32바이트 이상)
JWT_SECRET=
JWT_ISSUER=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# 인증 쿠키·클라이언트
AUTH_COOKIE_SECURE=true
AUTH_APP_CLIENT_ENABLED=true

# 감사 (기본 1. 골격 마이그레이션 V1_0_1이 만드는 시스템 계정의 ID)
AUDIT_SYSTEM_ACTOR_ID=

# 첫 관리자 (선택). 둘 다 주고 한 번 띄우면 ADMIN이 없을 때만 만든다. 첫 로그인 때 비밀번호를 바꾼다. 만든 뒤에는 지운다
BOOTSTRAP_ADMIN_LOGIN_ID=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# CORS (쉼표로 구분)
CORS_ALLOWED_ORIGINS=

# API 문서 (운영에서는 false)
SWAGGER_ENABLED=false

# 로그 파일 (선택. 비우면 콘솔에만 쓴다. prod 프로필에서 날짜별로 나누고 30일·3GB를 넘으면 지운다)
LOG_FILE=

# 접속 이력 보관 기간 (선택 헬퍼 login-history)
LOGIN_HISTORY_RETENTION_DAYS=90

# 알림 (moa 007). 개인 알림 보관 기간
NOTIFICATION_RETENTION_DAYS=90

# 브라우저 알림(웹 푸시) VAPID 키. 비우면 브라우저 알림을 끈다. 만드는 법은 specs/007-notifications/quickstart.md
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
