# 백엔드 환경변수 목록. 값은 시크릿 저장소에 두고 이 파일에는 이름만 적는다 (harness-psw 5.3)
# application.yml이 이 이름들을 읽는다. 필수 값이 비면 시작할 때 실패한다.

# DB (local 프로필은 compose.yaml이 자동으로 채운다)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT (필수. 32바이트 이상)
JWT_SECRET=
JWT_ISSUER=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# 인증 쿠키·클라이언트
AUTH_COOKIE_SECURE=true
AUTH_APP_CLIENT_ENABLED=true

# 감사 (필수. 사용자 도메인이 만든 시스템 계정의 ID)
AUDIT_SYSTEM_ACTOR_ID=

# CORS (쉼표로 구분)
CORS_ALLOWED_ORIGINS=

# API 문서 (운영에서는 false)
SWAGGER_ENABLED=false
