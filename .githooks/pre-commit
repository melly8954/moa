#!/bin/sh
# 시크릿 스캔. 스테이징된 변경에 비밀값이 섞였는지 gitleaks로 검사한다.
# 설정: git config core.hooksPath .githooks
# 첫 줄을 /bin/sh로 둔다. bash를 찾으면 Windows에서 WSL 실행기를 집을 수 있다

gl="$(command -v gitleaks 2>/dev/null)"

# Windows에서 winget으로 설치한 직후에는 열려 있던 셸의 PATH에 반영되지 않는다. 설치 위치를 직접 찾는다
if [ -z "$gl" ] && [ -n "${LOCALAPPDATA:-}" ]; then
  for d in "$LOCALAPPDATA/Microsoft/WinGet/Links" "$LOCALAPPDATA"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*; do
    if [ -x "$d/gitleaks.exe" ]; then gl="$d/gitleaks.exe"; break; fi
  done
fi

if [ -z "$gl" ]; then
  echo "gitleaks를 찾지 못해 커밋을 막았다. (winget install --id Gitleaks.Gitleaks)" >&2
  echo "  설치했다면 터미널(또는 Claude 세션, GitHub Desktop)을 새로 열어 PATH를 다시 읽는다." >&2
  exit 1
fi
exec "$gl" git --pre-commit --staged --redact --no-banner
